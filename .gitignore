# ============================================================
# TrainerForge — .gitignore
# Spring Boot + React + Vite + TypeScript + PostgreSQL + Docker
# ============================================================

# Compiled and Bytecode
*.class
*.jar
*.war
*.ear
*.nar

# Maven's Output Directory
target/

# Maven Wrapper (only JAR)
.mvn/wrapper/maven-wrapper.jar

!**/src/main/**/target/
!**/src/test/**/target/

# STS
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# Spring Boot / App Logs
*.log
logs/

# Dependencies
node_modules/
.pnpm-store

# Vite Build
frontend/dist/
frontend/build/
frontend/.vite/

# TypeScript & testing cache
*.tsbuildinfo
frontend/coverage/
frontend/.nyc_output/

# Tools and packages
.codegraph

# ========== IDEs ==========

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# IntelliJ IDEA
.idea
.idea/
*.iws
*.iml
*.ipr

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# Eclipse / NetBeans / Vim / Emacs
.classpath
.project
.settings/
nbproject/
*.swp
*.swo
*~

# ========== OPERATING SYSTEMS ==========

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ========== ENVIRONMENT AND SECRETS ==========

# Environment Variables
.env
.env.*
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Public Template (NO real values)
!.env.example
!.env.properties.example

# Keys and certificates
*.pem
*.key
*.p12
*.jks
secrets/

# Secret config or real credentials
application-prod.yml
application-prod.properties
application-local.yml
application-local.properties

# ========== DATABASE ==========

# PostgreSQL Backups and Dumps 
*.sql.gz
*.dump
*.backup
db-backup/
postgres-data/

# ========== DOCKER ==========

docker-compose.override.yml
.docker/
quick_start.sh

# ========== TESTING ==========

coverage/
*.lcov
.nyc_output/
jacoco.exec
jacoco/

# ========== MISC ==========

tmp/
temp/
*.tmp
*.temp
.cache/
.parcel-cache/
dist/
release/
Memory.md
